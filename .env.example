# Supabase project (Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The publishable key (sb_publishable_…) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Server only. The secret key (sb_secret_…) or the legacy service_role key.
# Used for exactly one thing: sending invitation emails through Supabase Auth.
# Never used to read or write health data.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Claude (document extraction and the health assistant)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Public URL of this app, used in invitation links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
