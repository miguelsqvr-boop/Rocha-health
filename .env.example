# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used for exactly one thing: sending invitation emails through
# Supabase Auth. Never used to read or write health data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude (document extraction and the health assistant)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Public URL of this app, used in invitation links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
